{
  "name": "puck-advisor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --experimental-strip-types --watch src/server/index.ts",
    "dev:client": "cd client && npm run dev",
    "build": "tsc -p tsconfig.json && cd client && npm install && npm run build",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && cd client && npm install && npm run typecheck",
    "test": "node --experimental-strip-types --test \"src/server/**/*.test.ts\""
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "fastify": "^5.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3"
  }
}
